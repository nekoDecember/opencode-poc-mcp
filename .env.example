# WSLから見えるWindowsの保存先。OneDrive利用時は実際のパスへ変更する。
SCREENSHOT_HOST_DIR='/mnt/c/Users/YOUR_NAME/Pictures/Screenshots'
MCP_PORT=8000

# 設定ファイルには値を書かず、環境変数名だけを登録する。
GITEA_USERNAME=
GITEA_PASSWORD=
TAVILY_API_KEY=

# 通常のHTTPプロキシ。未使用なら空欄。小文字を優先し、大文字も同じ値にする。
http_proxy=
https_proxy=
no_proxy=localhost,127.0.0.1,mcp,gitea.example.internal,.example.internal
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# ブラウザで秘密情報を入力するときだけ使用。値はツール引数に渡さない。
INTRANET_USERNAME=
INTRANET_PASSWORD=
